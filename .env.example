# Copy this file to .env and fill in your own values. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL_CHEAP=openai/gpt-4.1-mini
OPENROUTER_MODEL_EXPENSIVE=openai/gpt-4.1-mini

# OpenAI-compatible local server (for example Ollama or llama.cpp).
LOCAL_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
LOCAL_LLM_MODEL_CHEAP=qwen2.5:14b
LOCAL_LLM_MODEL_EXPENSIVE=qwen2.5:32b

LISTENBRAINZ_TOKEN=
LISTENBRAINZ_USER=
ENCORE_USER_ID=
CONTACT_EMAIL=you@umontana.edu

# Optional; relative paths resolve under ./data (default: ./data/memory).
ENCORE_MEMORY_DIR=memory


# setlist.fm API key (free, non-commercial) for the setlist-mcp server.
SETLIST_API_KEY=
